# Environment & Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://docreader:secure_pass_123@localhost:5432/docreader?sslmode=disable

# Redis (optional, enables distributed rate limiting)
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (Min 32 characters in production)
JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long_123456
ADMIN_JWT_SECRET=dev_admin_jwt_secret_must_be_at_least_32_characters_long_123456

# Offline Entitlement Signing (Ed25519 - generate using 'npm run keys')
OFFLINE_TOKEN_PRIVATE_KEY=""
OFFLINE_TOKEN_PUBLIC_KEY=""

# AdMob Rewarded Ads Verification
ADMOB_REWARD_AMOUNT=10

# Google Play Billing Integration
PLAY_PACKAGE_NAME=com.docreader.app
GOOGLE_PLAY_CREDENTIALS_JSON=""

# Google Play Cloud Pub/Sub
PUBSUB_VERIFICATION_TOKEN=dev_pubsub_token_secret

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DocReader <noreply@docreaderapp.com>"
SUPPORT_EMAIL=support@docreader.app

